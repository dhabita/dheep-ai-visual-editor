# Copy this file to .env and fill in your values.
#
# No ANTHROPIC_API_KEY needed — edits run through your local Claude Code CLI,
# which uses your existing `claude` login (subscription). Make sure you can run
# `claude` in a terminal first.

# Absolute or relative path to the website project that Claude is allowed to edit.
# This is the CLI's working directory; all edits happen inside it.
PROJECT_ROOT=./example-site

# Port for the HTTP/SSE server (overlay.js + /task live here)
SERVER_PORT=3000

# Port for the hot-reload WebSocket server
WS_PORT=3001

# --- Multi-project auto-discovery ---
# Folders searched to auto-register a project by id (= folder name) with no
# projects.json edit and no restart. Comma/colon-separated.
# Default: the folder that contains this editor repo (e.g. ~/Documents/GitHub).
# WORKSPACE_ROOTS=~/Documents/GitHub,~/work
# Restrict which roots POST /register may add (defaults to WORKSPACE_ROOTS).
# ALLOWED_PROJECT_ROOTS=~/Documents/GitHub

# --- Optional ---
# Model alias or full name passed to the CLI (default: sonnet)
# CLAUDE_MODEL=sonnet
# Permission mode: acceptEdits (default) | bypassPermissions | default
# PERMISSION_MODE=acceptEdits
# Path to the claude binary if it isn't on PATH
# CLAUDE_BIN=claude
# Per-task timeout in ms (default: 240000)
# TASK_TIMEOUT_MS=240000
